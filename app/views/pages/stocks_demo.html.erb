<div class="pt-8 px-4 sm:px-8 bg-black min-h-screen text-slate-200 pb-20">
  <div class="w-full max-w-4xl mx-auto space-y-6">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-4 border-b border-slate-800/80">
      <div>
        <h1 class="text-xl font-bold text-white tracking-tight">Stock Portfolio Demo</h1>
        <p class="text-slate-400 font-mono text-xs mt-0.5">Live positions & total value sync</p>
      </div>

      <% if @last_snapshot %>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-mono bg-emerald-950/40 border border-emerald-800/50 text-emerald-400">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            Synced <%= time_ago_in_words(@last_snapshot.created_at) %> ago
          </span>
        </div>
      <% end %>
    </div>

    <% if @last_snapshot %>
      <div class="bg-slate-950/80 border border-slate-800/80 rounded-xl p-5 space-y-1">
        <p class="text-slate-400 font-mono text-[11px] uppercase tracking-wider">Total Portfolio Value</p>
        <div class="flex items-baseline gap-3">
          <span class="text-3xl font-bold text-white font-mono tracking-tight">
            <%= number_to_currency(@last_snapshot.total_value, unit: "$") %>
          </span>
          <span class="text-slate-500 font-mono text-xs uppercase"><%= @last_snapshot.stock_broker %></span>
        </div>
      </div>

      <div class="bg-slate-950/80 border border-slate-800/80 rounded-xl p-5 space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-slate-800/60">
          <div>
            <h2 class="text-white text-sm font-semibold tracking-tight">Holdings</h2>
            <p class="text-slate-400 font-mono text-xs mt-0.5">Positions in latest snapshot</p>
          </div>
          <span class="text-slate-400 font-mono text-xs"><%= @last_snapshot.stocks.size %> positions</span>
        </div>

        <div class="space-y-2.5">
          <%= render partial: "stock_snapshots/stock", collection: @last_snapshot.stocks.sort_by { |s| -s.price.to_f }, as: :stock %>
        </div>
      </div>
    <% else %>
      <div class="bg-slate-950/80 border border-slate-800/80 rounded-xl p-12 text-center space-y-3">
        <p class="text-slate-300 font-semibold text-sm">No portfolio snapshot yet</p>
        <p class="text-slate-500 font-mono text-xs max-w-sm mx-auto">
          Sync with eToro has not run yet. Run background sync to fetch your initial positions.
        </p>
      </div>
    <% end %>

  </div>
</div>