
<div class="pt-8 px-4 sm:px-8 bg-black min-h-screen text-slate-200">
  <div class="w-full max-w-5xl mx-auto space-y-6">

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-slate-950/80 border border-slate-800/60 rounded-xl p-4">
        <p class="text-slate-400 font-mono text-[11px] tracking-wider uppercase">Total Balance</p>
        <p class="text-white text-2xl font-bold font-mono tracking-tight mt-1">
          <%= number_to_currency(@latest_snapshot&.total_balance || 0, unit: "€", format: "%u %n") %>
        </p>
        <div class="flex items-center gap-1.5 mt-2 text-xs font-mono text-slate-400">
          <span class="text-[11px]">Aggregated EUR</span>
        </div>
      </div>

      <div class="bg-slate-950/80 border border-slate-800/60 rounded-xl p-4">
        <p class="text-slate-400 font-mono text-[11px] tracking-wider uppercase">Total Profit / Loss</p>
        <% profit = @latest_snapshot&.profit_loss || 0 %>
        <p class="<%= profit >= 0 ? 'text-emerald-400' : 'text-rose-400' %> text-2xl font-bold font-mono tracking-tight mt-1">
          <%= profit >= 0 ? "+ " : "- " %><%= number_to_currency(profit.abs, unit: "€", format: "%u %n") %>
        </p>
        <div class="flex items-center gap-1.5 mt-2 text-xs font-mono text-slate-400">
          <% if @latest_snapshot&.total_investments.to_f > 0 %>
            <% percentage = ((profit / @latest_snapshot.total_investments) * 100).round(2) %>
            <span class="<%= profit >= 0 ? 'text-emerald-400' : 'text-rose-400' %> font-semibold">
              <%= profit >= 0 ? "+#{percentage}%" : "#{percentage}%" %>
            </span>
            <span class="text-[10px]">on investments</span>
          <% else %>
            <span class="text-[11px]">Unrealized P/L</span>
          <% end %>
        </div>
      </div>

      <div class="bg-slate-950/80 border border-slate-800/60 rounded-xl p-4">
        <p class="text-slate-400 font-mono text-[11px] tracking-wider uppercase">Invested Capital</p>
        <p class="text-white text-2xl font-bold font-mono tracking-tight mt-1">
          <%= number_to_currency(@latest_snapshot&.total_investments || 0, unit: "€", format: "%u %n") %>
        </p>
        <div class="flex items-center gap-1.5 mt-2 text-xs font-mono text-slate-400">
          <span class="text-[11px]">In open positions</span>
        </div>
      </div>

      <div class="bg-slate-950/80 border border-slate-800/60 rounded-xl p-4">
        <p class="text-slate-400 font-mono text-[11px] tracking-wider uppercase">Available Cash</p>
        <p class="text-white text-2xl font-bold font-mono tracking-tight mt-1">
          <%= number_to_currency(@latest_snapshot&.available_cash || 0, unit: "€", format: "%u %n") %>
        </p>
        <div class="flex items-center gap-1.5 mt-2 text-xs font-mono text-indigo-400">
          <span class="text-[11px]">
            <%= @latest_snapshot&.created_at ? "Sync: #{time_ago_in_words(@latest_snapshot.created_at)} ago" : "No sync yet" %>
          </span>
        </div>
      </div>
    </div>

    <div data-controller="chart"
         data-chart-hourly-value="<%= @hourly_data.to_json %>"
         data-chart-daily-value="<%= @daily_data.to_json %>"
         class="bg-slate-950/80 border border-slate-800/60 rounded-2xl p-6 sm:p-8">

      <div class="flex flex-col sm:flex-row justify-between items-start gap-4 mb-6">
        <div>
          <h2 class="text-white text-xl font-bold tracking-tight">Portfolio Performance</h2>
          <p class="text-slate-400 text-xs font-mono mt-0.5">Historical valuation in EUR</p>
        </div>

        <div class="text-left sm:text-right font-mono">
          <span class="text-slate-400 text-xs tracking-wider uppercase">Snapshot Profit</span>
          <div id="returnValue" class="text-2xl font-bold text-emerald-400 tracking-tight transition-all duration-200">
            -
          </div>
          <div id="returnPercentage" class="text-xs font-semibold text-emerald-400 mt-0.5 inline-flex items-center px-2 py-0.5 rounded bg-emerald-500/10">
            -
          </div>
        </div>
      </div>

      <div id="buttonsContainer" class="flex gap-2 mb-6"></div>
      <div id="chartContainer" class="w-full h-[380px]"></div>
    </div>

  </div>
</div>