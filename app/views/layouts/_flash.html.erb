<div id="flash">
  <% if notice.present? %>
    <div
      data-controller="notification"
      data-notification-delay-value="3000"
      class="fixed top-4 left-1/2 -translate-x-1/2 z-50 transition transform duration-500"
      data-transition-enter-from="opacity-0 -translate-y-2"
      data-transition-enter-to="opacity-100 translate-y-0"
      data-transition-leave-from="opacity-100 translate-y-0"
      data-transition-leave-to="opacity-0 -translate-y-2"
    >
      <div class="bg-slate-800 border border-slate-700 text-slate-200 text-sm px-6 py-3 rounded-lg shadow-lg flex items-center gap-3">
        <span><%= notice %></span>
        <button data-action="notification#hide" class="text-slate-400 hover:text-white transition">✕</button>
      </div>
    </div>
  <% end %>

  <% if alert.present? %>
    <div
      data-controller="notification"
      data-notification-delay-value="3000"
      class="fixed top-4 left-1/2 -translate-x-1/2 z-50 transition transform duration-500"
      data-transition-enter-from="opacity-0 -translate-y-2"
      data-transition-enter-to="opacity-100 translate-y-0"
      data-transition-leave-from="opacity-100 translate-y-0"
      data-transition-leave-to="opacity-0 -translate-y-2"
    >
      <div class="bg-red-900 border border-red-800 text-red-200 text-sm px-6 py-3 rounded-lg shadow-lg flex items-center gap-3">
        <span><%= alert %></span>
        <button data-action="notification#hide" class="text-red-400 hover:text-red-200 transition">✕</button>
      </div>
    </div>
  <% end %>
</div>