<div class="bg-slate-950 border border-slate-800/50 rounded-xl p-5 flex items-center justify-between">
  <div class="flex items-center gap-4">
    <div class="w-9 h-9 rounded-lg flex items-center justify-center">
      <% case api_credential.provider %>
      <% when "etoro" %>
        <%= image_tag("etoro_logo.png", class: "w-10 h-10 object-contain") %>
      <% when "trading212" %>
        <%= image_tag("trading212_icon.png", class: "w-10 h-10 object-contain") %>
      <% else %>
        <%= "Unknown provider !" %>
      <% end %>

    </div>
    <div>
      <p class="text-white font-semibold text-sm tracking-tight capitalize"><%= api_credential.provider %></p>
      <p class="text-slate-400 text-xs mt-0.5">ID: <%= api_credential.api_id %></p>

    </div>
  </div>


  <div class="flex items-center gap-2">
    <%= link_to "Edit","", class: "text-slate-400 hover:text-white hover:bg-slate-800 px-3 py-1.5 rounded-lg text-sm font-medium transition-all" %>
    <%= button_to "Delete", "", method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "text-red-400 hover:text-red-300 hover:bg-red-900/30 px-3 py-1.5 rounded-lg text-sm font-medium transition-all cursor-pointer bg-transparent border-0" %>
  </div>
</div>
