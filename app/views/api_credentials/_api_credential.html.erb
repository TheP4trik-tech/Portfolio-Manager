<%= turbo_frame_tag dom_id(api_credential) do %>
  <div class="group bg-slate-950/80 hover:bg-slate-900/40 border border-slate-800/60 hover:border-slate-700/80 rounded-xl p-4 sm:p-5 flex items-center justify-between gap-4 transition-all duration-200">
    <div class="flex items-center gap-3.5 min-w-0">
      <div class="w-10 h-10 rounded-xl bg-slate-900 border border-slate-800/80 flex items-center justify-center flex-shrink-0 p-1.5 shadow-inner">
        <% case api_credential.provider %>
        <% when "etoro" %>
          <%= image_tag("etoro_logo.png", class: "w-full h-full object-contain") %>
        <% when "trading212" %>
          <%= image_tag("trading212_icon.png", class: "w-full h-full object-contain") %>
        <% else %>
          <span class="text-xs font-mono text-slate-500 font-bold">?</span>
        <% end %>
      </div>

      <div class="min-w-0">
        <div class="flex items-center gap-2">
          <p class="text-white font-semibold text-sm tracking-tight capitalize truncate">
            <%= api_credential.provider %>
          </p>
          <% if api_credential.error_sent? %>
            <span class="badge badge-xs badge-neutral border-slate-700 text-red-400 font-mono">Error</span>
          <% else %>
            <span class="badge badge-xs badge-neutral border-slate-700 text-emerald-400 font-mono">Active</span>
          <% end %>

        </div>
        <p class="text-slate-400 font-mono text-xs mt-0.5 tracking-tight truncate">
          ID: <span class="text-slate-300"><%= api_credential.api_id %></span>
        </p>
      </div>
    </div>

    <div class="flex items-center gap-1.5 flex-shrink-0">
      <%= link_to "Edit", edit_api_credential_path(api_credential), class: "btn btn-ghost btn-xs text-slate-300 hover:text-white hover:bg-slate-800/80 font-mono text-[11px] tracking-wide rounded-lg px-2.5 py-1 transition-all" %>
      <%= button_to "Delete", api_credential_path(api_credential), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-ghost btn-xs text-rose-400/80 hover:text-rose-300 hover:bg-rose-950/30 font-mono text-[11px] tracking-wide rounded-lg px-2.5 py-1 transition-all cursor-pointer" %>
    </div>
  </div>
<% end %>