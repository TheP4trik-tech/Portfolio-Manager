<%= turbo_frame_tag @api_credential do %>
<div class="min-h-screen bg-slate-950 p-8">
  <div class="max-w-2xl mx-auto">

    <div class="mb-6">
      <%= link_to "Back", api_credentials_path, data: {turbo_frame: "_top"}, class: "text-slate-400 hover:text-white text-sm transition" %>
    </div>

    <div class="bg-slate-900 border border-slate-800/50 rounded-2xl p-8">
      <h1 class="text-white text-xl font-semibold mb-6">Edit Credential</h1>

      <%= form_with model: @api_credential, class: "space-y-5" do |f| %>

        <div>
          <%= f.label :provider, class: "block text-sm font-medium text-slate-300 mb-2" %>
          <%= f.select :provider, [["Trading 212", "trading212"], ["eToro", "etoro"]], {},
                       class: "w-full bg-slate-800 border border-slate-700 text-white rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-indigo-500 transition" %>
        </div>

        <div>
          <%= f.label :api_id, "API ID", class: "block text-sm font-medium text-slate-300 mb-2" %>
          <%= f.text_field :api_id, class: "w-full bg-slate-800 border border-slate-700 text-white rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-indigo-500 transition" %>
        </div>

        <div data-controller="password-visibility" class="relative">
          <%= f.label :api_key, "API Key", class: "block text-sm font-medium text-slate-300 mb-2" %>
          <%= f.password_field :api_key, data: { "password-visibility-target": "input" }, spellcheck: false, class: "w-full bg-slate-800 border border-slate-700 text-white rounded-lg px-4 py-3 pr-12 text-sm focus:outline-none focus:border-indigo-500 transition" %>
          <button type="button" data-action="password-visibility#toggle" class="absolute right-3 top-10 text-slate-400 hover:text-white transition">
            <span data-password-visibility-target="icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </span>
                    <span data-password-visibility-target="icon" class="hidden">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 4.411m0 0L21 21" />
              </svg>
            </span>
          </button>
        </div>

        <div class="pt-2">
          <%= f.submit "Save changes", data: { turbo_frame: "_top" }, class: "w-full bg-indigo-600 hover:bg-indigo-500 text-white font-semibold py-3 rounded-lg text-sm transition cursor-pointer" %>
        </div>

      <% end %>
    </div>
  </div>
</div>
<% end %>