<%= turbo_frame_tag @api_credential do %>
  <div class="bg-slate-900 border border-slate-800/50 rounded-2xl p-6 mt-4 max-w-sm">
    <h2 class="text-white text-xs font-semibold tracking-widest uppercase mb-5">New Credential</h2>

    <%= form_with model: @api_credential do |f| %>

      <div class="mb-4">
        <%= f.label :provider, class: "block text-xs font-semibold tracking-widest uppercase text-slate-400 mb-2" %>
        <%= f.select :provider, [["Trading 212", "trading212"], ["eToro", "etoro"]], {},
                     class: "select select-sm select-bordered w-full bg-slate-800 border-slate-700 text-white" %>     </div>

      <div class="mb-4">
        <%= f.label :api_id, "API ID", class: "block text-xs font-semibold tracking-widest uppercase text-slate-400 mb-2" %>
        <%= f.text_field :api_id, placeholder: "Your API ID",
                         class: "w-full bg-slate-800 border border-slate-700 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500 transition placeholder-slate-600" %>
      </div>

      <div class="mb-5">
        <%= f.label :api_key, "API Key", class: "block text-xs font-semibold tracking-widest uppercase text-slate-400 mb-2" %>
        <%= f.password_field :api_key, placeholder: "Your API Key",
                             class: "w-full bg-slate-800 border border-slate-700 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500 transition placeholder-slate-600" %>
      </div>

      <%= f.submit "Save", class: "bg-slate-800 hover:bg-slate-700 border border-slate-700 text-white text-xs font-semibold tracking-widest uppercase px-5 py-2 rounded-lg transition cursor-pointer" %>

    <% end %>
  </div>
<% end %>