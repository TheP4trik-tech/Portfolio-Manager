<div class="min-h-screen flex items-center justify-center bg-slate-950 px-4 py-12">
  <div class="w-full max-w-md px-4 sm:px-8">

    <div class="mb-8 text-center">
      <h1 class="text-3xl font-bold text-white tracking-tight">Account settings</h1>
      <p class="text-slate-400 mt-2 text-xs font-mono">Update your profile information</p>
    </div>

    <div class="bg-slate-950/80 rounded-2xl p-6 sm:p-8 border border-slate-800/80 shadow-2xl">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>

        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="mb-4">
          <%= f.label :email, class: "block text-slate-400 font-mono text-[11px] uppercase tracking-wider mb-1.5" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
                            class: "w-full bg-slate-900 border border-slate-800 text-slate-200 font-mono text-xs rounded-lg px-3.5 py-2 focus:border-indigo-500/50 focus:outline-none transition placeholder:text-slate-600" %>
          <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
            <p class="text-amber-400 text-xs font-mono mt-1">Waiting confirmation for: <%= resource.unconfirmed_email %></p>
          <% end %>
        </div>

        <div class="mb-4">
          <div class="flex items-center justify-between mb-1.5">
            <%= f.label :password, class: "text-slate-400 font-mono text-[11px] uppercase tracking-wider" %>
            <span class="text-slate-500 font-mono text-[10px]">Leave blank to keep</span>
          </div>
          <%= f.password_field :password, autocomplete: "new-password", placeholder: (@minimum_password_length ? "#{@minimum_password_length} chars min" : "••••••••"),
                               class: "w-full bg-slate-900 border border-slate-800 text-slate-200 font-mono text-xs rounded-lg px-3.5 py-2 focus:border-indigo-500/50 focus:outline-none transition placeholder:text-slate-600" %>
        </div>

        <div class="mb-4">
          <%= f.label :password_confirmation, class: "block text-slate-400 font-mono text-[11px] uppercase tracking-wider mb-1.5" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "••••••••",
                               class: "w-full bg-slate-900 border border-slate-800 text-slate-200 font-mono text-xs rounded-lg px-3.5 py-2 focus:border-indigo-500/50 focus:outline-none transition placeholder:text-slate-600" %>
        </div>

        <div class="mb-6">
          <div class="flex items-center justify-between mb-1.5">
            <%= f.label :current_password, class: "text-slate-400 font-mono text-[11px] uppercase tracking-wider" %>
            <span class="text-slate-500 font-mono text-[10px]">Needed for changes</span>
          </div>
          <%= f.password_field :current_password, autocomplete: "current-password", placeholder: "••••••••",
                               class: "w-full bg-slate-900 border border-slate-800 text-slate-200 font-mono text-xs rounded-lg px-3.5 py-2 focus:border-indigo-500/50 focus:outline-none transition placeholder:text-slate-600" %>
        </div>

        <div>
          <%= f.submit "Update account", class: "btn btn-sm w-full bg-indigo-600 hover:bg-indigo-500 text-white font-mono text-xs tracking-wider border-0 rounded-lg py-2 transition cursor-pointer" %>
        </div>

      <% end %>

      <div class="mt-8 pt-6 border-t border-slate-800/80">
        <p class="text-rose-400/90 font-mono text-[11px] uppercase tracking-wider mb-2">Danger zone</p>
        <%= button_to "Cancel my account",
                      registration_path(resource_name),
                      data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" },
                      method: :delete,
                      class: "btn btn-sm w-full bg-rose-950/30 hover:bg-rose-900/50 border border-rose-900/60 text-rose-300 font-mono text-xs tracking-wider rounded-lg py-2 transition cursor-pointer" %>
      </div>

      <div class="mt-4 text-center">
        <%= link_to "← Back", :back, class: "text-slate-500 hover:text-slate-300 font-mono text-xs transition" %>
      </div>
    </div>
  </div>
</div>