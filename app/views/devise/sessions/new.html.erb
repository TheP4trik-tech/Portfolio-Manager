<div class="min-h-screen flex items-center justify-center bg-slate-950 px-4 py-12">
  <div class="w-full max-w-md px-4 sm:px-8">

    <div class="mb-8 text-center">
      <h1 class="text-3xl font-bold text-white tracking-tight">Personal Finance</h1>
      <p class="text-slate-400 mt-2 text-xs font-mono">Log in to your account</p>
    </div>

    <div class="bg-slate-950/80 rounded-2xl p-6 sm:p-8 border border-slate-800/80 shadow-2xl">
      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

        <div class="mb-4">
          <%= f.label :email, class: "block text-slate-400 font-mono text-[11px] uppercase tracking-wider mb-1.5" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "user@example.com",
                            class: "w-full bg-slate-900 border border-slate-800 text-slate-200 font-mono text-xs rounded-lg px-3.5 py-2 focus:border-indigo-500/50 focus:outline-none transition placeholder:text-slate-600" %>
        </div>

        <div class="mb-4">
          <%= f.label :password, class: "block text-slate-400 font-mono text-[11px] uppercase tracking-wider mb-1.5" %>
          <%= f.password_field :password, autocomplete: "current-password", placeholder: "••••••••",
                               class: "w-full bg-slate-900 border border-slate-800 text-slate-200 font-mono text-xs rounded-lg px-3.5 py-2 focus:border-indigo-500/50 focus:outline-none transition placeholder:text-slate-600" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center gap-2 mb-6">
            <%= f.check_box :remember_me, class: "checkbox checkbox-xs rounded bg-slate-900 border-slate-700 checked:bg-indigo-600" %>
            <%= f.label :remember_me, class: "text-slate-400 font-mono text-xs cursor-pointer select-none" %>
          </div>
        <% end %>

        <div>
          <%= f.submit "Log in", class: "btn btn-sm w-full bg-indigo-600 hover:bg-indigo-500 text-white font-mono text-xs tracking-wider border-0 rounded-lg py-2 transition cursor-pointer" %>
        </div>

      <% end %>

      <div class="mt-4 pt-4 border-t border-slate-800/60">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>