<div class="flex items-center justify-between p-3.5 bg-slate-900/60 border border-slate-800/80 rounded-lg hover:border-slate-700/80 transition-colors">
  <div class="flex items-center gap-3">
    <% if stock.icon_uri.present? %>
      <%= image_tag stock.icon_uri, alt: stock.name, class: "w-9 h-9 rounded-full object-cover border border-slate-700/60" %>
    <% else %>
      <div class="w-9 h-9 rounded-full bg-slate-800 border border-slate-700/60 flex items-center justify-center text-slate-400 font-mono text-xs font-semibold">
        <%= stock.name.to_s[0..1].upcase %>
      </div>
    <% end %>

    <div>
      <h3 class="text-sm font-semibold text-white tracking-tight leading-tight"><%= stock.name %></h3>
      <p class="text-[11px] font-mono text-slate-400 mt-0.5">
        <%= number_with_precision(stock.units, precision: 4) %> units &bull; Invested <%= number_to_currency(stock.invested_amount, unit: "$") %>
      </p>
    </div>
  </div>

  <div class="text-right font-mono">
    <div class="text-sm font-semibold text-white tracking-tight">
      <%= number_to_currency(stock.price, unit: "$") %>
    </div>

    <div class="text-[11px] font-medium <%= stock.profitable? ? 'text-emerald-400' : 'text-rose-400' %>">
      <%= stock.profitable? ? "+#{number_to_currency(stock.profit_loss, unit: "$")}" : number_to_currency(stock.profit_loss, unit: "$") %>
      (<%= stock.profitable? ? "+#{stock.profit_loss_percentage}%" : "#{stock.profit_loss_percentage}%" %>)
    </div>
  </div>
</div>