<div class="min-h-screen bg-slate-950 p-8">
  <div class="max-w-3xl mx-auto">

    <div class="flex items-center justify-between mb-6">
      <h1 class="text-white text-xs font-semibold tracking-widest uppercase">Profile</h1>
      <%= link_to "EDIT", edit_user_path(current_user), class: "text-slate-400 hover:text-white px-4 py-2 rounded-lg text-xs font-semibold tracking-widest transition-all" %>
    </div>

    <div class="bg-slate-950 border border-slate-800/50 rounded-xl p-5 space-y-4">

      <div class="flex items-center justify-between border-b border-slate-800/50 pb-4">
        <span class="text-slate-400 text-xs font-semibold tracking-widest uppercase">Name</span>
        <span class="text-white text-sm"><%= current_user.first_name %> <%= current_user.last_name %></span>
      </div>

      <div class="flex items-center justify-between border-b border-slate-800/50 pb-4">
        <span class="text-slate-400 text-xs font-semibold tracking-widest uppercase">Email</span>
        <span class="text-white text-sm"><%= current_user.email %></span>
      </div>

      <div class="flex items-center justify-between border-b border-slate-800/50 pb-4">
        <span class="text-slate-400 text-xs font-semibold tracking-widest uppercase">Member since</span>
        <span class="text-white text-sm"><%= current_user.created_at.strftime("%B %Y") %></span>
      </div>

      <div class="flex items-center justify-between">
        <span class="text-slate-400 text-xs font-semibold tracking-widest uppercase">Snapshots</span>
        <span class="text-white text-sm"><%= current_user.cash_snapshots.count %></span>
      </div>

    </div>
  </div>
</div>